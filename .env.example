# Hermes Dashboard — Environment Variables
# Copy this file to .env.local for local development, or set these in
# Vercel Dashboard → Project → Settings → Environment Variables

# ============================================================================
# SUPABASE (Required)
# ============================================================================
# Found in: Supabase Dashboard → Project Settings → API
SUPABASE_URL=https://your-project.supabase.co
# Service role key (server-side only — never expose to client)
# Found in: Supabase Dashboard → Project Settings → API → service_role key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ============================================================================
# HERMES AGENT (Optional — for chat endpoint)
# ============================================================================
# Only needed for the /api/agents/:id/chat endpoint to call the real Hermes CLI.
# Without this, chat returns a demo stub response.
# On Vercel serverless, the Hermes CLI is not available — chat will always stub.
# For full chat functionality, deploy to a VPS with tmux support.
# 
# hermes OPENROUTER API key (if not using the one configured in ~/.hermes/.env)
# OPENROUTER_API_KEY=sk-or-v1-...
